rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(ownerUid) {
      return isAuthenticated() && request.auth.uid == ownerUid;
    }

    function belongsToTenant(tenantId) {
      return isAuthenticated() && (
        request.auth.token.tenantId == tenantId || 
        request.auth.token.tenant == tenantId ||
        request.auth.uid == tenantId
      );
    }

    // --- Rules ---

    // Inventory: Public read
    match /inventory_projects/{projectId} {
      allow read: if true;
    }

    // Sites: Public read, Owner write
    match /sites/{siteId} {
      allow read: if true; 
      allow create: if isOwner(request.resource.data.ownerUid);
      allow update, delete: if isOwner(resource.data.ownerUid);
    }

    // Jobs: Owner only
    match /jobs/{jobId} {
      allow read, create: if isOwner(request.resource.data.ownerUid);
      allow update, delete: if isOwner(resource.data.ownerUid);
    }

    // User Profiles
    match /users/{uid} {
      allow read: if isAuthenticated();
      allow write: if request.auth.uid == uid;
    }

    // Tenants and Subcollections
    match /tenants/{tenantId} {
      allow read: if belongsToTenant(tenantId);
      
      match /leads/{leadId} {
        // Anyone can create a lead (from a public site)
        allow create: if true;
        // Only the tenant can read/update leads
        allow read, update, delete: if belongsToTenant(tenantId);
      }

      match /events/{eventId} {
        allow create: if true;
        allow read: if belongsToTenant(tenantId);
      }

      match /ads_campaigns/{campaignId} {
        allow read, write: if belongsToTenant(tenantId);
      }

      // Allow access to any other subcollection if they belong to the tenant
      match /{allSubcollections=**} {
        allow read, write: if belongsToTenant(tenantId);
      }
    }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
