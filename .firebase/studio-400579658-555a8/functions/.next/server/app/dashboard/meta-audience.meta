{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/dashboard/layout,_N_T_/dashboard/meta-audience/layout,_N_T_/dashboard/meta-audience/page,_N_T_/dashboard/meta-audience"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/dashboard/meta-audience/__PAGE__",
    "/dashboard/meta-audience",
    "/dashboard",
    "/_index",
    "/_head"
  ]
}