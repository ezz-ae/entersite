# EntreSite OS - Production Environment Template

# --- Firebase Client Configuration ---
# Get these from your Firebase Project Settings > General > Your Apps
NEXT_PUBLIC_FIREBASE_CONFIG='{"apiKey": "...", "authDomain": "...", "projectId": "...", "storageBucket": "...", "messagingSenderId": "...", "appId": "..."}'

# --- Firebase Admin Configuration ---
# Required for server-side operations (Scripts, API Routes, Workers)
# You can provide the full JSON or individual fields
FIREBASE_PROJECT_ID="..."
FIREBASE_CLIENT_EMAIL="..."
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional fallback if you want to use the raw JSON string
# FIREBASE_SERVICE_ACCOUNT_JSON='{...}'

# --- AI Orchestration (Google Gemini / Vertex AI) ---
# Required for Genkit Flows
GOOGLE_GENAI_API_KEY="..."

# --- Messaging: Email (SendGrid) ---
SENDGRID_API_KEY="SG.xxx"
SENDGRID_FROM_EMAIL="noreply@yourdomain.com"

# --- Messaging: SMS/WhatsApp (Twilio) ---
TWILIO_ACCOUNT_SID="ACxxx"
TWILIO_AUTH_TOKEN="..."
TWILIO_FROM_NUMBER="+1xxx"

# --- Payments: PayPal ---
PAYPAL_CLIENT_ID="..."
PAYPAL_CLIENT_SECRET="..."
PAYPAL_API_BASE="https://api-m.paypal.com" # Use https://api-m.sandbox.paypal.com for testing

# --- Payments: Ziina (UAE Regional) ---
ZIINA_API_KEY="xxx"
ZIINA_BASE_URL="https://api.ziina.com" # Use https://api.sandbox.ziina.com for testing

# --- Social Ads: Meta (Facebook/Instagram) ---
FB_ACCESS_TOKEN="EAxxx"
FB_APP_ID="123456"
FB_AD_ACCOUNT_ID="act_123456"

# --- System Configuration ---
NODE_ENV="production"
SITE_URL="https://your-deployment-url.com"
